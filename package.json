{
  "name": "copy-code-path",
  "displayName": "Copy Code Path",
  "publisher": "misemo",
  "description": "复制选中代码的文件路径和行号到剪贴板",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copy-code-path.copyPath",
        "title": "Copy Code Path with Line Numbers"
      }
    ],
    "keybindings": [
      {
        "command": "copy-code-path.copyPath",
        "key": "ctrl+alt+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0"
  }
}
